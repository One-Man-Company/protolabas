{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-man-company.github.io/protolabas/schema/module.schema.json",
  "title": "Protolabas modulis",
  "description": "Vienas interaktyvus mokymosi modulis. Visi tekstai, kuriuos mato vaikas, yra lietuvių kalba.",
  "type": "object",
  "required": [
    "id",
    "grade",
    "subject",
    "subjectLabel",
    "title",
    "tagline",
    "icon",
    "minutes",
    "curriculum",
    "objectives",
    "outcome",
    "s1",
    "activities",
    "teacher"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL dalis. Privalo sutapti su aplanko pavadinimu."
    },
    "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
    "subject": {
      "type": "string",
      "enum": [
        "matematika",
        "lietuviu",
        "gamta",
        "visuomeninis",
        "dorinis",
        "daile",
        "muzika",
        "choras",
        "fizinis",
        "sokis",
        "informatika",
        "technologijos"
      ]
    },
    "subjectLabel": { "type": "string", "minLength": 2 },
    "chipClass": { "type": "string" },
    "title": { "type": "string", "minLength": 3, "maxLength": 60 },
    "tagline": { "type": "string", "minLength": 8, "maxLength": 120 },
    "icon": { "type": "string", "minLength": 1, "maxLength": 8 },
    "color": { "type": "string" },
    "minutes": { "type": "integer", "minimum": 3, "maximum": 15 },
    "curriculum": {
      "type": "object",
      "required": ["program", "area", "codes", "status"],
      "properties": {
        "program": { "type": "string", "minLength": 5 },
        "area": { "type": "string", "minLength": 3 },
        "codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-ZĄČĘĖĮŠŲŪŽ][\\wĄČĘĖĮŠŲŪŽąčęėįšųūž ()]{1,40} (?:[0-9]{2}(?:\\.[0-9]{1,3}){1,3}|[A-F][0-9](?:\\.[0-9])?)$"
          },
          "description": "Oficialūs programos numeriai SU dalyko priešdėliu, nes 22.x/23.x/24.x/25.x numeracija kartojasi tarp dalykų."
        },
        "note": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["privaloma", "papildoma"],
          "description": "S1-04: privalomas ir papildomas turinys atskirtas duomenimis."
        }
      }
    },
    "s1": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^S1-[0-9]{2}$" },
      "description": "Kanoniniai Švietimas #1 taisyklių ID iš guidelines/svietimas1-rules.json."
    },
    "outcome": {
      "type": "string",
      "minLength": 20,
      "description": "S1-02: išmatuojamas mokymosi rezultatas vienu sakiniu."
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 5 }
    },
    "designNotes": {
      "type": "object",
      "required": ["branduolineIdeja", "simTipas", "kognityvineApkrova", "ux", "evidence"],
      "properties": {
        "branduolineIdeja": { "type": "string", "minLength": 15 },
        "simTipas": {
          "type": "string",
          "enum": [
            "vote",
            "manipulate",
            "build",
            "classify",
            "match",
            "variables",
            "scenario",
            "roles",
            "fairshare",
            "strategy",
            "rhythm",
            "melody",
            "move",
            "dance"
          ]
        },
        "kognityvineApkrova": { "type": "string", "minLength": 15 },
        "ux": { "type": "string", "minLength": 15 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "description": "Nuorodos į wiki/00-bendra/mokymosi-mokslas.md įrašus."
        },
        "pastaba": { "type": "string" }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["talk", "sim", "quiz", "reflect"] },
          "title": { "type": "string" },
          "text": { "type": "string", "maxLength": 320 },
          "visual": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "sim": { "type": "string" },
          "config": { "type": "object" },
          "question": { "type": "string" },
          "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answer": { "type": "integer", "minimum": 0 },
          "hint": { "type": "string" },
          "explain": { "type": "string" },
          "chips": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "quiz" } }, "required": ["type"] },
            "then": { "required": ["question", "options", "answer"] }
          },
          {
            "if": { "properties": { "type": { "const": "sim" } }, "required": ["type"] },
            "then": { "required": ["sim"] }
          },
          {
            "if": { "properties": { "type": { "const": "talk" } }, "required": ["type"] },
            "then": { "required": ["title", "text"] }
          }
        ]
      }
    },
    "teacher": {
      "type": "object",
      "required": ["tikslas", "eiga", "diferencijavimas", "refleksija"],
      "description": "S1-17: mokytojo medžiaga. Privaloma net jei vaikas mokosi savarankiškai.",
      "properties": {
        "tikslas": { "type": "string", "minLength": 10 },
        "priemones": { "type": "array", "items": { "type": "string" } },
        "eiga": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "diferencijavimas": {
          "type": "object",
          "required": ["pagalba", "issukis"],
          "properties": {
            "pagalba": { "type": "string" },
            "issukis": { "type": "string" }
          }
        },
        "refleksija": { "type": "string" }
      }
    }
  }
}
